<?xml version="1.0"?>
<ruleset name="wp-s3-offload">
    <description>WordPress Coding Standards for the whole plugin (ported from sw-backupit; this plugin is entirely WordPress adapter code, so there is no separate PSR-12 core ruleset).</description>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="cache" value=".phpcs.cache"/>
    <file>includes</file>
    <file>templates</file>
    <file>wp-s3-offload.php</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <config name="minimum_wp_version" value="6.4"/>
    <config name="testVersion" value="8.2-"/>

    <rule ref="WordPress">
        <!-- Project decision (as in sw-backupit CODE-STYLE 3.1): PSR-4 class names/files (PascalCase) in the namespaced plugin code. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Short ternaries are allowed for brevity. -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <!-- Method names follow WordPress snake_case; camelCase is kept where interfaces/hooks dictate it. -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.InterpolatedVariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
        <!-- Typed signatures carry the contract; docblocks are added incrementally (same documented exception as sw-backupit). -->
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.VariableComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <exclude name="Squiz.Commenting.FileComment.SpacingAfterOpen"/>
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
        <!-- Exception messages are plain text shown in admin notices or AJAX responses, never echoed into HTML unescaped. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array"><element value="wp-s3-offload"/></property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array"><element value="wps3"/><element value="WPS3"/></property>
        </properties>
    </rule>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
